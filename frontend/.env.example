# 복사해서 .env.local로 사용. 실제 값은 커밋하지 않는다.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_NFT_CONTRACT_ID=nearenvelope.testnet
NEXT_PUBLIC_FT_CONTRACT_ID=usdc.nearenvelope.testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
# false = 테스트넷 컨트랙트 사용. true면 컨트랙트 없이 목업 데이터로 동작 (src/lib/near/mock.ts)
NEXT_PUBLIC_USE_MOCK=false
